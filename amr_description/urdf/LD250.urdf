<?xml version="1.0" ?>
<robot name="LD250">
  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <link name="base_link">
  </link>
  <link name="amr_base">
    <visual>
      <origin rpy="0 0 3.141582654" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://amr_description/meshes/LD250.obj"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 3.141592654" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://amr_description/meshes/LD250.obj"/>
      </geometry>
    </collision>
    <inertial>
